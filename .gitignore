js/dist/

# JS
node_modules/

# Bundled JS (built by `bun js/build.ts`)
App/Resources/pi-runtime.js
Packages/PiRuntime/Tests/PiRuntimeTests/Resources/*.js

# Local secrets and config — never commit
LocalConfig.xcconfig
*.local.json
.env
.env.*

# Test artifacts
scripts/.out/

# macOS / editors
.DS_Store
.swiftpm/
*.swp
.vscode/
.idea/
